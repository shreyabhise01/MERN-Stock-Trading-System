# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/stock_trading_db
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=32e5d9b17589222db76faa928bdfefe1e8c76410cb47618a48eb39cb8b6e4da62885b718c520bd20551ec5939c1aa7a1
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Set to true ONLY if MongoDB runs as a replica set (e.g. MongoDB Atlas). Standalone MongoDB does not support transactions.
USE_DB_TRANSACTIONS=false
# Used only by "npm run seed" to create the first admin account
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisStrongPassword1
